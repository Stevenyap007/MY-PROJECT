{
 "uid": "iot-livingroom",
 "title": "Living room monitoring",
 "tags": [
  "iot"
 ],
 "timezone": "browser",
 "editable": true,
 "graphTooltip": 1,
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "timepicker": {
  "refresh_intervals": [
   "5s",
   "10s",
   "30s",
   "1m",
   "5m"
  ]
 },
 "templating": {
  "list": [
   {
    "name": "ds",
    "label": "Data source",
    "type": "datasource",
    "query": "influxdb",
    "current": {},
    "hide": 2,
    "refresh": 1,
    "regex": "",
    "options": []
   }
  ]
 },
 "annotations": {
  "list": []
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Temperature now",
   "datasource": {
    "type": "influxdb",
    "uid": "${ds}"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 5,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "${ds}"
     },
     "query": "from(bucket: \"iot_logs\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"environment\" and r._field == \"temperature\")\n  |> last()"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "celsius",
     "mappings": [],
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 28
       },
       {
        "color": "red",
        "value": 32
       }
      ]
     },
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center",
    "orientation": "auto",
    "wideLayout": true,
    "showPercentChange": false
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Humidity now",
   "datasource": {
    "type": "influxdb",
    "uid": "${ds}"
   },
   "gridPos": {
    "x": 5,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "${ds}"
     },
     "query": "from(bucket: \"iot_logs\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"environment\" and r._field == \"humidity\")\n  |> last()"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "mappings": [],
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     },
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center",
    "orientation": "auto",
    "wideLayout": true,
    "showPercentChange": false
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Light",
   "datasource": {
    "type": "influxdb",
    "uid": "${ds}"
   },
   "gridPos": {
    "x": 9,
    "y": 0,
    "w": 5,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "${ds}"
     },
     "query": "from(bucket: \"iot_logs\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"snapshot\" and r._field == \"light\")\n  |> last()"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "Off",
         "color": "#8e8e8e",
         "index": 0
        },
        "1": {
         "text": "On",
         "color": "#f2b705",
         "index": 1
        }
       }
      }
     ],
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center",
    "orientation": "auto",
    "wideLayout": true,
    "showPercentChange": false
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Air conditioner",
   "datasource": {
    "type": "influxdb",
    "uid": "${ds}"
   },
   "gridPos": {
    "x": 14,
    "y": 0,
    "w": 5,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "${ds}"
     },
     "query": "from(bucket: \"iot_logs\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"snapshot\" and r._field == \"ac\")\n  |> last()"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "Off",
         "color": "#8e8e8e",
         "index": 0
        },
        "1": {
         "text": "On",
         "color": "#3c8dbc",
         "index": 1
        }
       }
      }
     ],
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
